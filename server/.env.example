# Server Environment Variables Configuration
NODE_ENV=development
APP_PORT=3000

# Database
DB_STRING=mongodb://localhost:27017/saas-starter

# Frontend & CORS
FRONT_END_URL=localhost:5173
CORS_EXTRA_ORIGINS=

# Session Security
EXPRESS_SESSION_SECRET=replace-with-a-secure-random-string-at-least-32-chars

# Email Service
# Choose 'smtp' for local development/testing, or 'mailgun' for production
EMAIL_PROVIDER=smtp
WEBSITE_DOMAIN=example.com

# Mailgun Configuration (required if EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMTP Configuration (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_...
STRIPE_STANDARD_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Google reCAPTCHA v2 (bypassed in development if unset)
GOOGLE_RECAPTCHA_SECRET_KEY=

# Error Monitoring (optional)
SENTRY_DSN=
